{
  "manifest_version": 3,
  "name": "Freshsales Name Checker",
  "version": "1.7.0",
  "description": "Локальна перевірка листа перед відправкою та підсвічування статусу гравця.",
  "permissions": ["storage"],
  "content_scripts": [{
    "matches": ["https://bbq1-465157612863820669.myfreshworks.com/crm/messaging/*"],
    "js": ["checker.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://cardona.boffice.site/*"],
    "js": ["boffice.js"],
    "run_at": "document_idle"
  }]
}
